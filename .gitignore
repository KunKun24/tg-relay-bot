# 私有环境配置（真实 Bot Token、管理员 ID 等，用 .env.example 作模板）
.env

# 虚拟环境与 Python 缓存
.venv/
__pycache__/
.pytest_cache/
*.pyc

# SQLite 数据库与备份（含客户数据，不开源）
*.db
*.db-wal
*.db-shm
*.sqlite3*

# 运行时目录与日志
data/
logs/
backups/
*.bak*
